#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

#define DEFAULT 0 
#define KP_ARROWS_LAYER 1 
#define FN_LAYER 2 
#define ARM_LAYER 3 

/ {
    behaviors {
        bspc_del_word: backspace_delete_word {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp BACKSPACE>, <&kp LC(BSPC)>;
            mods = <(MOD_RSFT)>;
        };

        // Hold = right shift. Tap = arm ARM_LAYER briefly so that a following
        // hold of the left thumb shift key activates the nav layer.
        rsft_arm: right_shift_arm {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&sl_arm>;
        };

        // Sticky layer with a short window: the "fast-ish succession" timing.
        sl_arm: sticky_layer_arm {
            compatible = "zmk,behavior-sticky-key";
            #binding-cells = <1>;
            bindings = <&mo>;
            release-after-ms = <400>;
        };
    };
};

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer { // Layer 0
            bindings = <
                &kp GRAVE   &kp N1    &kp N2    &kp N3         &kp N4               &kp N5         &kp N6     &kp N7      &kp N8     &kp N9    &kp N0     &kp MINUS
                &kp TAB     &kp Q     &kp W     &kp E          &kp R                &kp T          &kp Y      &kp U       &kp I      &kp O     &kp P      &kp BSLH
                &kp CAPS    &kp A     &kp S     &kp D          &kp F                &kp G          &kp H      &kp J       &kp K      &kp L     &kp SEMI   &kp SQT
                &none       &kp Z     &kp X     &kp C          &kp V                &kp B          &kp N      &kp M       &kp COMMA  &kp DOT   &kp FSLH   &none
                &kp LCTRL   &kp LGUI  &kp LALT  &kp DELETE                                                                &kp LBKT   &kp RBKT  &kp PSCRN  &mo FN_LAYER
                                                &bspc_del_word &kp LSHIFT           &kp ESC        &kp ENTER  &rsft_arm RSHIFT ARM_LAYER &kp SPACE
            >;
        };

        kp_arrows_layer{ // layer for keypad on the right half of the keyboard, arrows to the left and the bluetooth and flashing commands
            bindings = <
                &bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3   &none          &none  &none   &kp FSLH  &kp STAR  &none      &none
                &none       &kp PG_UP     &kp LC(LEFT)  &kp UP        &kp LC(RIGHT)  &none          &kp Y  &kp N7  &kp N8    &kp N9    &kp MINUS  &none
                &none       &kp HOME      &kp LEFT      &kp DOWN      &kp RIGHT      &kp END        &kp H  &kp N4  &kp N5    &kp N6    &kp PLUS   &none
                &trans      &kp PG_DN     &kp LC(X)     &kp LC(C)     &kp LC(V)      &none          &kp N  &kp N1  &kp N2    &kp N3    &kp EQUAL  &none
                &none       &none         &none         &trans                                                     &kp N0    &kp DOT   &none      &none
                                                        &trans        &none          &trans         &trans &trans  &trans
            >;
        };

        fn_layer{ // layer for arrow keys on the left half of the keyboard and function keys on the top
            bindings = <
                &none   &kp F1  &kp F2  &kp F3         &kp F4  &kp F5           &kp F6   &kp F7  &kp F8    &kp F9  &kp F10   &kp F11
                &none   &none   &none   &none          &none   &none            &none    &none   &none     &none   &none     &kp F12
                &none   &none   &none   &none          &none   &none            &none    &none   &none     &none   &none     &none
                &trans  &none   &none   &kp RA(COMMA)  &none   &none            &none    &none   &none     &none   &none     &none
                &none   &none   &none   &trans                                                   &none     &none   &none     &none
                                        &kp LC(BSPC)   &none   &trans           &trans   &trans  &trans
            >;

        };

        arm_layer { // Layer 3: briefly armed by tapping the right thumb shift; the left thumb shift then acts as nav layer key
            bindings = <
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &mo KP_ARROWS_LAYER &trans &trans &trans &trans
            >;
        };
    };
};
